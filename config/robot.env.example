# Copy to robot.env. This file is sourced by bash: quote values containing spaces.
# These settings MUST match the robot. Do not change the school robot firmware.
ROS_DISTRO=jazzy
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# Official image default wired address; verify with your TA if it was changed.
ROBOT_IP=192.168.185.3
# Leave unset for Simple Discovery; if the robot uses Discovery Server, match it.
# Example for server ID 0 (only if that server is enabled on the robot):
# ROS_DISCOVERY_SERVER=192.168.185.3:11811
# ROS_SUPER_CLIENT=true
# Optional existing official user-PC discovery setup file, sourced before overrides.
# TB4_DISCOVERY_SETUP=/etc/turtlebot4_discovery/setup.bash
ROBOT_NAMESPACE=
SCAN_TOPIC=scan
IMAGE_TOPIC=oakd/rgb/preview/image_raw
CAMERA_INFO_TOPIC=oakd/rgb/preview/camera_info
MAP_FRAME=map
ODOM_FRAME=odom
BASE_FRAME=base_link
# Additional static parent above hardware odom, captured once at fresh mapping start.
SLAM_ODOM_FRAME=mission_odom
RVIZ=true
# Keep conservatively below the default TB4 speed while carrying a laptop.
MAX_LINEAR_SPEED=0.20
MAX_ANGULAR_SPEED=0.60
ROBOT_RADIUS=0.22
INFLATION_RADIUS=0.45
PREFLIGHT_TIMEOUT=20
# Optional: absolute directory for timestamped run outputs; default <project>/results.
# RESULTS_DIR=/home/student/tb4-results
